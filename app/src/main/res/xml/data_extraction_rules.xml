<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for Android 12+ (API 31+).
   Controls cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include app preferences -->
        <include domain="sharedpref" path="." />

        <!-- Exclude sensitive shared preferences -->
        <exclude domain="sharedpref" path="hogwarts_secure_prefs.xml" />
        <exclude domain="sharedpref" path="hogwarts_biometric_creds.xml" />
    </cloud-backup>

    <device-transfer>
        <!-- Include app preferences -->
        <include domain="sharedpref" path="." />

        <!-- Exclude sensitive data -->
        <exclude domain="sharedpref" path="hogwarts_secure_prefs.xml" />
        <exclude domain="sharedpref" path="hogwarts_biometric_creds.xml" />
    </device-transfer>
</data-extraction-rules>
